GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=moonshotai/kimi-k2-instruct-0905
SHR_MODE=suggestion   # suggestion | guardrail
SHR_LOG_LEVEL=info    # info | debug | warning

# CORS Configuration
# For local development (default if not set):
# CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000
# For production, set to your trusted domains:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional: Custom forbidden keywords (comma-separated)
# SHR_FORBIDDEN_KEYWORDS=fraud,scam,money laundering,embezzle,bribe

# Optional: LLM retry configuration
# SHR_MAX_RETRIES=3
# SHR_RETRY_DELAY=1.0
